VITE_API_BASE=http://localhost:5000
VITE_ALLOWED_EMAIL=digitrans.ai@gmail.com

# 業務洽詢表單端點（AbiAsstAPI 的 abisales Webhook）
VITE_ABISALES_API_URL=https://www.digitrans.cloud:4430/api/abisales
# HMAC-SHA256 共用簽章金鑰，必須與 AbiAsstAPI Web.config 的 AbiSales:SignKey 完全一致
# 正式建置時由 GitHub Actions secret ABISALES_SIGN_KEY 注入，請勿將正式值提交進版控
VITE_ABISALES_SIGN_KEY=
